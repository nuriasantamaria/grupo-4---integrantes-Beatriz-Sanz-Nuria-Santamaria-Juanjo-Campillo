"Write a function to integrate a Cauchy problem. Temporal scheme, initial"
"condition and the function F (U, t) of the Cauchy problem should be input"
"arguments."
scheme = {euler, crank_nicolson, rk4, inverse_euler}
def integrate_cauchy(U0, t0, tf, delta, F, scheme):
      Nv=len(U0)
      N=len(tf-t0) -1
      U=np.zeros((N+1,Nv))
      U[0,:]=U0
      for n in range(0,N):
          U[n+1,:]=scheme(U[n,:],t0+n*delta,delta,F)
      return U

