"Write a function called Euler to integrate one step. The function F (U, t)"
"of the Cauchy problem should be input argument."

def euler(U, t, delta, F):
    return U + delta * F(U, t)

"Write a function called Crank_Nicolson to integrate one step."
def crank_nicolson(U, t, delta, F):
	max_iterations = 1000

	for _ in range(max_iterations):
		Y_next = U[0, :] + delta / 2 * (F(U[0, :], t) + F(Y, t + delta))
		if np.linalg.norm(Y_next - Y) <= 1e-6:
			U[1, :] = Y_next
			return U
		Y = Y_next


"Write a function called RK4 to integrate one step."
def rk4(U, t, delta, F):
    k1 = F(U, t)
    k2 = F(U + delta / 2 * k1, t + delta / 2)
    k3 = F(U + delta / 2 * k2, t + delta / 2)
    k4 = F(U + delta * k3, t + delta)
    return U + (delta / 6) * (k1 + 2 * k2 + 2 * k3 + k4)

"Write a function called Inverse_Euler to integrate one step."
def inverse_euler(U, t, delta, F):
    max_iterations = 1000
    Y = U[0, :]

    for _ in range(max_iterations):
        Y_next = U[0, :] + delta * F(Y, t + delta)
        if np.linalg.norm(Y_next - Y) <= 1e-6:
            U[1, :] = Y_next
            return U
        Y = Y_next
        return U
    
